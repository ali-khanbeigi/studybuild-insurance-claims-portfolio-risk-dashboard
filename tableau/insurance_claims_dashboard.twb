      <column caption='Bonus Malus' datatype='integer' name='[BonusMalus]' role='measure' type='quantitative' />
      <column caption='Extreme Claims Flag' datatype='integer' name='[Calculation_1729663772474245120]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [ExtremeClaim] THEN 1 ELSE 0 END' />
      </column>
      <column caption='Extreme Claim Cost Share' datatype='real' name='[Calculation_1729663772474654721]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [ExtremeClaim]&#13;&#10;    THEN [ClaimAmount]&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;)&#13;&#10;/&#13;&#10;SUM([ClaimAmount])' />
      </column>
      <column aggregation='Max' caption='Top 1 Percent Cost Share' datatype='real' name='[Calculation_1729663772475088898]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [cumulative_claim_share] &lt;= 0.01&#13;&#10;THEN [cumulative_cost_share]&#13;&#10;END' />
      </column>
      <column caption='extreme claim count' datatype='integer' name='[Calculation_2183119961924919296]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [ExtremeClaim]&#13;&#10;    THEN 1&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;)' />
      </column>
